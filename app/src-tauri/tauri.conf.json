{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "译读",
  "version": "0.1.0",
  "identifier": "com.yidu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "译读",
        "url": "index.html",
        "width": 1280,
        "height": 840
      },
      {
        "label": "quick",
        "title": "快捷翻译",
        "url": "quick.html",
        "width": 420,
        "height": 660,
        "visible": false,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
