{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "译读",
  "version": "0.2.0",
  "identifier": "com.yidu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "译读",
        "url": "index.html",
        "width": 1280,
        "height": 840,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "quick",
        "title": "快捷翻译",
        "url": "quick.html",
        "width": 420,
        "height": 660,
        "visible": false,
        "skipTaskbar": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ggygy/yidu/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwNzM5QjMzMTczRDVDMUUKUldRZVhEMFhNNXR6a0hzTm5URFBBNnNZR0ZEd0Fsd1N0VmlkeVJ4YVlvbm5IUlJkZ09Wb3NjR2IK"
    }
  }
}
