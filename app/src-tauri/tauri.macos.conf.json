{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "译读",
        "url": "index.html",
        "width": 1280,
        "height": 840,
        "minWidth": 640,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 28 },
        "transparent": true,
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" }
      },
      {
        "label": "quick",
        "title": "快捷翻译",
        "url": "quick.html",
        "width": 420,
        "height": 660,
        "minWidth": 360,
        "minHeight": 300,
        "visible": false,
        "skipTaskbar": true,
        "resizable": true,
        "acceptFirstMouse": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 24 },
        "transparent": true,
        "windowEffects": { "effects": ["popover"], "state": "active" }
      }
    ]
  }
}
