{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "md-translator-proto",
  "version": "0.1.0",
  "identifier": "com.prototype.mdtranslator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "译读 · MD 翻译器(原型)",
        "url": "index.html",
        "width": 1280,
        "height": 840
      },
      {
        "label": "quick",
        "title": "快捷翻译",
        "url": "quick.html",
        "width": 420,
        "height": 660,
        "visible": false,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
